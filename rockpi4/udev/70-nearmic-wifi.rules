# USB Wi-Fi on a 24/7 audio appliance: no Wi-Fi power save (it adds 100+ ms
# latency spikes and drops) and no USB autosuspend for the adapter.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan*", RUN+="/usr/sbin/iw dev %k set power_save off"
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan*", SUBSYSTEMS=="usb", ATTRS{power/control}=="*", RUN+="/bin/sh -c 'for d in /sys/class/net/%k/device/../power/control /sys/class/net/%k/device/power/control; do [ -w $d ] && echo on > $d; done'"
# netplan's wpa_supplicant unit is only pulled in at boot. An adapter plugged
# in later (or one that re-enumerates) would otherwise sit unassociated until
# nearmic-wifi-watchdog notices, so start it as soon as wlan0 appears.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="netplan-wpa-wlan0.service"
