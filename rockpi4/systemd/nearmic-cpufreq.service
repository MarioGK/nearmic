[Unit]
Description=NearMic CPU frequency policy (performance, A53 1512 MHz, A72 1800 MHz)
Documentation=file:///usr/local/share/doc/nearmic/AUDIO.md
# armbian-hardware-optimize resets both clusters to 408-2016 MHz from
# /etc/default/cpufrequtils; run after it or this policy is silently undone
# (seen 2026-11-11: the unit was "active" while the cap was gone).
After=sysinit.target armbian-hardware-optimize.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Same policy as /etc/default/cpufrequtils (rockpi4/config/cpufrequtils), which
# Armbian applies in the background at boot. This unit applies it immediately
# on install and again at boot; see that file for the reasons.
ExecStart=/bin/sh -c 'for p in /sys/devices/system/cpu/cpufreq/policy*; do echo performance > $p/scaling_governor; echo 1800000 > $p/scaling_max_freq; echo 1416000 > $p/scaling_min_freq; done'

[Install]
WantedBy=multi-user.target
