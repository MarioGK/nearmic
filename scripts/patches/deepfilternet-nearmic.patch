+
+pub mod prof {
+    use std::cell::RefCell;
+    use std::time::Duration;
+    thread_local! { static P: RefCell<[f64; 7]> = RefCell::new([0.0; 7]); }
+    pub fn add(a: Duration, b: Duration, c: Duration) {
+        if std::env::var_os("DF_PROF").is_none() { return; }
+        P.with(|p| {
+            let mut p = p.borrow_mut();
+            let (a, b, c) = (a.as_secs_f64() * 1e3, b.as_secs_f64() * 1e3, c.as_secs_f64() * 1e3);
+            p[0] += 1.0; p[1] += a; p[2] += b; p[3] += c;
+            p[4] = p[4].max(a); p[5] = p[5].max(b); p[6] = p[6].max(a + b + c);
+            if p[0] as u64 % 200 == 0 {
+                let n = p[0];
+                eprintln!("prof n={} enc={:.2} erb={:.2} df={:.2} ms | max enc={:.2} erb={:.2} total={:.2}", n, p[1]/n, p[2]/n, p[3]/n, p[4], p[5], p[6]);
+            }
+        });
+    }
+}
