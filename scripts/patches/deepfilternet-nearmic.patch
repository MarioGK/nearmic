diff --git i/libDF/src/tract.rs w/libDF/src/tract.rs
index b39a987..97bc3af 100644
--- i/libDF/src/tract.rs
+++ w/libDF/src/tract.rs
@@ -227,6 +227,57 @@ pub struct DfTract {
     rolling_spec_buf_y: VecDeque<Tensor>, // Enhanced stage 1 spec buf
     rolling_spec_buf_x: VecDeque<Tensor>, // Noisy spec buf
     skip_counter: usize,  // Increment when wanting to skip processing due to low RMS
+    par: ParSlot,         // Optional second thread running the ERB decoder
+}
+
+/// The ERB decoder and the DF decoder only depend on the encoder output, so
+/// they can run at the same time. `ParDec` owns a copy of the ERB decoder on a
+/// helper thread; the calling thread runs the DF decoder meanwhile. Frame
+/// results are identical to the serial path, with no extra latency.
+pub struct ParDec {
+    tx: std::sync::mpsc::SyncSender<Vec<Tensor>>,
+    rx: std::sync::mpsc::Receiver<Result<Tensor>>,
+}
+
+/// A cloned `DfTract` falls back to the serial decoder path.
+#[derive(Default)]
+pub struct ParSlot(Option<ParDec>);
+impl Clone for ParSlot {
+    fn clone(&self) -> Self {
+        ParSlot(None)
+    }
+}
+
+extern "C" {
+    fn sched_setscheduler(pid: i32, policy: i32, param: *const i32) -> i32;
+}
+
+impl ParDec {
+    fn spawn(plan: TypedSimplePlan<TypedModel>) -> Result<Self> {
+        let (tx, req_rx) = std::sync::mpsc::sync_channel::<Vec<Tensor>>(1);
+        let (resp_tx, rx) = std::sync::mpsc::sync_channel::<Result<Tensor>>(1);
+        // Same realtime class as the calling DSP worker, if the process may.
+        let prio: i32 = std::env::var("DF_RT_PRIO").ok().and_then(|v| v.parse().ok()).unwrap_or(10);
+        std::thread::Builder::new().name("df-erb-dec".into()).spawn(move || {
+            if prio > 0 {
+                unsafe { sched_setscheduler(0, 1, &prio) };
+            }
+            let mut erb_dec = match TypedSimpleState::new(plan) {
+                Ok(s) => s,
+                Err(_) => return,
+            };
+            while let Ok(inputs) = req_rx.recv() {
+                let inputs: TVec<TValue> = inputs.into_iter().map(TValue::from).collect();
+                let out = erb_dec
+                    .run(inputs)
+                    .map(|mut m| m.pop().unwrap().into_tensor());
+                if resp_tx.send(out).is_err() {
+                    break;
+                }
+            }
+        })?;
+        Ok(ParDec { tx, rx })
+    }
 }
 
